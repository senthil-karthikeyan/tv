# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Port the HTTP server listens on. Defaults to 8080 if unset.
PORT=8080

# Exact origin of the Angular frontend. Used for CORS and WebSocket origin validation.
FRONTEND_URL=http://localhost:4200

# Secret API key. Required. Clients must send this in the X-API-Key header on protected routes.
API_KEY=changeme-replace-with-a-strong-secret
