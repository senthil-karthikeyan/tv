# ---- build stage ----
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---- run stage ----
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

# replace my-app with the "name" in your package.json / angular.json
ARG APP_NAME=frontend
ENV APP_NAME=$APP_NAME

COPY --from=build /app/dist/${APP_NAME} ./dist/${APP_NAME}
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev

EXPOSE 4000
USER node
CMD ["sh", "-c", "node dist/${APP_NAME}/server/server.mjs"]